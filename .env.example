# Firebase Realtime Database URL (e.g. https://deepak-att-saas-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# Firebase Service Account JSON (minified, single line) from Firebase Console > Project Settings > Service accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Optional: Set a numeric PIN that guards the dashboard (e.g. 1234)
OWNER_PIN=choose-a-private-pin
